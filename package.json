{
  "name": "auth-service",
  "version": "0.0.1",
  "description": "Hub login with Google: issues the JWTs and publishes the JWKS",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "postinstall": "prisma generate"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.13.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "^12.18.0",
      "onFail": "download"
    }
  },
  "dependencies": {
    "@nestjs/common": "^12.5.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.5.0",
    "@nestjs/platform-fastify": "^12.5.0",
    "@prisma/adapter-neon": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "jose": "^6.2.18",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.13",
    "@nestjs/schematics": "^12.0.13",
    "@nestjs/testing": "^12.5.0",
    "@types/node": "^26.6.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-import-x": "^4.18.1",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.6.1",
    "prettier": "3.10.1",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.0",
    "vitest": "^5.1.0"
  }
}
